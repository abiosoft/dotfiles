#!/usr/bin/env bash

set -e

usage() {
    echo "usage: youtube-download [--hd | --4k] [--mp4] <video-url>"
    exit 1
}

if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    usage
fi

height=720
ext=webm
audio_ext=webm

while [ $# -gt 0 ]; do
    case "$1" in
        --hd)
            height=1080
            shift
            ;;
        --4k)
            height=2160
            shift
            ;;
        --mp4)
            ext=mp4
            audio_ext=m4a
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    usage
fi

url=$1

yt-dlp -f "bestvideo[height<=${height}][ext=${ext}]+bestaudio[ext=${audio_ext}]/best[height<=${height}][ext=${ext}]/best" --merge-output-format "${ext}" "${url}"
