#!/usr/bin/env bash

set -e

usage() {
    echo "usage: youtube-download [--hd | --4k] [--mp4] <video-url>"
    exit 1
}

if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    usage
fi

height=720
ext=webm
audio_ext=webm

while [ $# -gt 0 ]; do
    case "$1" in
        --hd)
            height=1080
            shift
            ;;
        --4k)
            height=2160
            shift
            ;;
        --mp4)
            ext=mp4
            audio_ext=m4a
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    usage
fi

url=$1

format="bestvideo[height<=${height}][ext=${ext}]+bestaudio[ext=${audio_ext}]/best[height<=${height}][ext=${ext}]"
merge_format=$ext

if [ "$ext" = webm ]; then
    webm_at_quality="bestvideo[height=${height}][ext=webm]+bestaudio[ext=webm]/best[height=${height}][ext=webm]"
    mp4_at_quality="bestvideo[height=${height}][ext=mp4]+bestaudio[ext=m4a]/best[height=${height}][ext=mp4]"
    mp4_fallback="bestvideo[height<=${height}][ext=mp4]+bestaudio[ext=m4a]/best[height<=${height}][ext=mp4]"
    # Prefer the requested resolution before falling back to lower resolutions.
    format="${webm_at_quality}/${mp4_at_quality}/${format}/${mp4_fallback}"
    merge_format="webm/mp4"
fi

yt-dlp -f "${format}/best" --merge-output-format "$merge_format" "$url"
