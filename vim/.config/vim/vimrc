vim9script

# Set mapleader FIRST before loading plugins and keymaps
g:mapleader = ','

var config_dir = expand('<sfile>:p:h') .. '/config'

execute 'source ' .. config_dir .. '/vimplug.vim'
execute 'source ' .. config_dir .. '/general.vim'
execute 'source ' .. config_dir .. '/theme.vim'
execute 'source ' .. config_dir .. '/fugitive.vim'
execute 'source ' .. config_dir .. '/go.vim'
execute 'source ' .. config_dir .. '/fzf.vim'
execute 'source ' .. config_dir .. '/netrw.vim'
execute 'source ' .. config_dir .. '/yank.vim'
